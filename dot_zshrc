# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Oh My Zsh Theme
ZSH_THEME="gnzh"

# Auto-update behavior
zstyle ':omz:update' mode reminder  # just remind me to update when it's time (other options: disabled | auto)

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(
	git
	# ssh
	zsh-syntax-highlighting
	sudo
	zsh-lsd
 	ohmyzsh-full-autoupdate # Auto Update Oh My Zsh plugins and themes when updating Oh My Zsh
)

source $ZSH/oh-my-zsh.sh

# Set environment language
export LANG=fr_FR.UTF-8

# Setup Zi
if [[ ! -f $HOME/.local/share/zi/bin/zi.zsh ]]; then
  print -P "%F{33}▓▒░ %F{160}Installing (%F{33}z-shell/zi%F{160})…%f"
  command mkdir -p "$HOME/.local/share/zi" && command chmod go-rwX "$HOME/.local/share/zi"
  command git clone -q --depth=1 --branch "main" https://github.com/z-shell/zi "$HOME/.local/share/zi/bin" && \
    print -P "%F{33}▓▒░ %F{34}Installation successful.%f%b" || \
    print -P "%F{160}▓▒░ The clone has failed.%f%b"
fi
source "$HOME/.local/share/zi/bin/zi.zsh"
autoload -Uz _zi
(( ${+_comps} )) && _comps[zi]=_zi
# examples here -> https://wiki.zshell.dev/ecosystem/category/-annexes
zicompinit # <- https://wiki.zshell.dev/docs/guides/commands

# Check Lsd availability
if ! command -v lsd &> /dev/null; then
  echo "⚠️  lsd n'est pas installé. Lance 'install_lsd' pour l'installer."
fi

install_lsd() {
  sudo apt update && sudo apt install -y lsd
}

# Opencode
export PATH=/home/choucroute/.opencode/bin:$PATH

# Auto update chezmoi and reload config
chezmoi update -a
chezmoi init
